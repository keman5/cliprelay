{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cliprelay-test",
  "main": "relay.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"cliprelay-test.macseek.cc","custom_domain":true}],
  "r2_buckets": [{"binding":"BOX","bucket_name":"cliprelay-test-ciphertext"}],
  "ratelimits": [{"name":"LIMIT","namespace_id":"24817","simple":{"limit":120,"period":60}}]
}

    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find paired devices and exchange encrypted clipboard items on your network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找已配对的设备，并在局域网内交换加密的剪贴板条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找已配對的裝置，並在區域網路上傳送加密的剪貼簿項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスを探し、ネットワーク上で暗号化したクリップボード項目を交換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링한 기기를 찾고 로컬 네트워크에서 암호화된 클립보드 항목을 교환합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Geräte suchen und verschlüsselte Inhalte der Zwischenablage im lokalen Netzwerk austauschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher les appareils jumelés et échanger des éléments chiffrés du presse-papiers sur le réseau local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar dispositivos emparejados e intercambiar elementos cifrados del portapapeles en la red local."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a device pairing card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描设备配对卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描裝置配對卡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのペアリングカードを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 페어링 카드를 스캔합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplungskarte eines Geräts scannen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner la carte de jumelage d’un appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear la tarjeta de emparejamiento de un dispositivo."
          }
        }
      }
    }
  },
  "version": "1.0"

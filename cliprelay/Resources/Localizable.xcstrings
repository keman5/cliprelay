{
  "sourceLanguage": "en",
  "strings": {
    "Fingerprint": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Fingerprint"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "指纹"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "指紋"}}, "ja": {"stringUnit": {"state": "translated", "value": "指紋"}}, "ko": {"stringUnit": {"state": "translated", "value": "지문"}}, "de": {"stringUnit": {"state": "translated", "value": "Fingerabdruck"}}, "fr": {"stringUnit": {"state": "translated", "value": "Empreinte"}}, "es": {"stringUnit": {"state": "translated", "value": "Huella"}}}},
    "Lock history": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lock history"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "锁定历史"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "鎖定記錄"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴をロック"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록 잠금"}}, "de": {"stringUnit": {"state": "translated", "value": "Verlauf sperren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Verrouiller l’historique"}}, "es": {"stringUnit": {"state": "translated", "value": "Bloquear historial"}}}},
    "Paired": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Paired"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "配对时间"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "配對時間"}}, "ja": {"stringUnit": {"state": "translated", "value": "ペアリング日時"}}, "ko": {"stringUnit": {"state": "translated", "value": "페어링 날짜"}}, "de": {"stringUnit": {"state": "translated", "value": "Gekoppelt am"}}, "fr": {"stringUnit": {"state": "translated", "value": "Jumelé le"}}, "es": {"stringUnit": {"state": "translated", "value": "Fecha de enlace"}}}},
    "Save clipboard while app is open": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save clipboard while app is open"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅在应用前台自动记录"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅在 App 前景自動記錄"}}, "ja": {"stringUnit": {"state": "translated", "value": "アプリの使用中に自動保存"}}, "ko": {"stringUnit": {"state": "translated", "value": "앱 사용 중 자동 저장"}}, "de": {"stringUnit": {"state": "translated", "value": "Bei geöffneter App automatisch sichern"}}, "fr": {"stringUnit": {"state": "translated", "value": "Enregistrer quand l’app est ouverte"}}, "es": {"stringUnit": {"state": "translated", "value": "Guardar con la app abierta"}}}},
    "iOS can ask before pasting. When history lock is on, shared history is hidden in the keyboard.": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "iOS can ask before pasting. When history lock is on, shared history is hidden in the keyboard."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "iOS 可能在读取剪贴板前询问。开启历史锁后，随贴键盘会隐藏共享历史。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "iOS 可能會在讀取剪貼簿前詢問。開啟記錄鎖後，鍵盤會隱藏共享記錄。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ペースト時に iOS が確認することがあります。ロック中はキーボードに履歴を表示しません。"}}, "ko": {"stringUnit": {"state": "translated", "value": "붙여넣기 전에 iOS가 허용 여부를 물을 수 있습니다. 잠금 중에는 키보드에서 공유 기록을 숨깁니다."}}, "de": {"stringUnit": {"state": "translated", "value": "iOS kann vor dem Einfügen nachfragen. Bei gesperrtem Verlauf bleibt er auf der Tastatur verborgen."}}, "fr": {"stringUnit": {"state": "translated", "value": "iOS peut demander une autorisation avant de coller. Le clavier masque l’historique verrouillé."}}, "es": {"stringUnit": {"state": "translated", "value": "iOS puede pedir permiso para pegar. El teclado oculta el historial bloqueado."}}}},
    "Clipboard history locked": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Clipboard history locked"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "剪贴板历史已锁定"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "剪貼簿記錄已鎖定"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴はロックされています"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록이 잠겼습니다"}}, "de": {"stringUnit": {"state": "translated", "value": "Verlauf gesperrt"}}, "fr": {"stringUnit": {"state": "translated", "value": "Historique verrouillé"}}, "es": {"stringUnit": {"state": "translated", "value": "Historial bloqueado"}}}},
    "Unlock history": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unlock history"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "解锁历史"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "解鎖記錄"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴をロック解除"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록 잠금 해제"}}, "de": {"stringUnit": {"state": "translated", "value": "Verlauf entsperren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Déverrouiller l’historique"}}, "es": {"stringUnit": {"state": "translated", "value": "Desbloquear historial"}}}},
    "Unlock history in ClipRelay": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Unlock history in ClipRelay"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "历史锁已开启，请在随贴中查看"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄已鎖定，請在隨貼中檢視"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴は ClipRelay で確認できます"}}, "ko": {"stringUnit": {"state": "translated", "value": "ClipRelay에서 잠금 해제"}}, "de": {"stringUnit": {"state": "translated", "value": "Verlauf in ClipRelay entsperren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Déverrouillez dans ClipRelay"}}, "es": {"stringUnit": {"state": "translated", "value": "Desbloquea en ClipRelay"}}}},
    "Relay connected": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Relay connected"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "中继连接正常"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "中繼連線正常"}}, "ja": {"stringUnit": {"state": "translated", "value": "リレーに接続しました"}}, "ko": {"stringUnit": {"state": "translated", "value": "릴레이 연결됨"}}, "de": {"stringUnit": {"state": "translated", "value": "Relay erreichbar"}}, "fr": {"stringUnit": {"state": "translated", "value": "Relais connecté"}}, "es": {"stringUnit": {"state": "translated", "value": "Retransmisor conectado"}}}},

    "Send to all devices (%lld)": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send to all devices (%lld)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送到全部设备（%lld 台）"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳送到所有裝置（%lld 部）"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべてのデバイスに送信（%lld 台）"}}, "ko": {"stringUnit": {"state": "translated", "value": "모든 기기로 보내기(%lld대)"}}, "de": {"stringUnit": {"state": "translated", "value": "An alle Geräte senden (%lld)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Envoyer à tous les appareils (%lld)"}}, "es": {"stringUnit": {"state": "translated", "value": "Enviar a todos los dispositivos (%lld)"}}}},
    "Delete from this Mac after copying": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Delete from this Mac after copying"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "复制后从这台 Mac 删除"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "拷貝後從這台 Mac 刪除"}}, "ja": {"stringUnit": {"state": "translated", "value": "コピー後にこの Mac から削除"}}, "ko": {"stringUnit": {"state": "translated", "value": "복사 후 이 Mac에서 삭제"}}, "de": {"stringUnit": {"state": "translated", "value": "Nach dem Kopieren von diesem Mac löschen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Supprimer de ce Mac après la copie"}}, "es": {"stringUnit": {"state": "translated", "value": "Eliminar de este Mac después de copiar"}}}},
    "Delivery status": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Delivery status"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送状态"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳送狀態"}}, "ja": {"stringUnit": {"state": "translated", "value": "配信状況"}}, "ko": {"stringUnit": {"state": "translated", "value": "전송 상태"}}, "de": {"stringUnit": {"state": "translated", "value": "Zustellstatus"}}, "fr": {"stringUnit": {"state": "translated", "value": "État de la livraison"}}, "es": {"stringUnit": {"state": "translated", "value": "Estado de entrega"}}}},
    "Cancel delivery": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Cancel delivery"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "取消发送"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "取消傳送"}}, "ja": {"stringUnit": {"state": "translated", "value": "送信を取り消す"}}, "ko": {"stringUnit": {"state": "translated", "value": "전송 취소"}}, "de": {"stringUnit": {"state": "translated", "value": "Zustellung abbrechen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Annuler l’envoi"}}, "es": {"stringUnit": {"state": "translated", "value": "Cancelar envío"}}}},
    "Received": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Received"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已收到"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已收到"}}, "ja": {"stringUnit": {"state": "translated", "value": "受信済み"}}, "ko": {"stringUnit": {"state": "translated", "value": "수신 완료"}}, "de": {"stringUnit": {"state": "translated", "value": "Empfangen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Reçu"}}, "es": {"stringUnit": {"state": "translated", "value": "Recibido"}}}},
    "Handed to relay · Delivery unconfirmed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Handed to relay · Delivery unconfirmed"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已交给中继，送达未确认"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已交給中繼，尚未確認送達"}}, "ja": {"stringUnit": {"state": "translated", "value": "中継に送信済み・到達未確認"}}, "ko": {"stringUnit": {"state": "translated", "value": "릴레이에 전달됨 · 수신 미확인"}}, "de": {"stringUnit": {"state": "translated", "value": "An Relay übergeben · Zustellung unbestätigt"}}, "fr": {"stringUnit": {"state": "translated", "value": "Transmis au relais · Livraison non confirmée"}}, "es": {"stringUnit": {"state": "translated", "value": "Entregado al retransmisor · Entrega sin confirmar"}}}},
    "Not sent": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not sent"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "未发送"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "未傳送"}}, "ja": {"stringUnit": {"state": "translated", "value": "未送信"}}, "ko": {"stringUnit": {"state": "translated", "value": "전송하지 않음"}}, "de": {"stringUnit": {"state": "translated", "value": "Nicht gesendet"}}, "fr": {"stringUnit": {"state": "translated", "value": "Non envoyé"}}, "es": {"stringUnit": {"state": "translated", "value": "Sin enviar"}}}},
    "已暂停记录与同步": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Capture and sync are paused"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已暂停记录与同步"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已暫停記錄與同步"}}, "ja": {"stringUnit": {"state": "translated", "value": "記録と同期を一時停止中"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록과 동기화가 일시 정지되었습니다"}}, "de": {"stringUnit": {"state": "translated", "value": "Aufzeichnung und Synchronisierung pausiert"}}, "fr": {"stringUnit": {"state": "translated", "value": "Capture et synchronisation en pause"}}, "es": {"stringUnit": {"state": "translated", "value": "Captura y sincronización en pausa"}}}},
    "发送测试文字": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send test text"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送测试文字"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳送測試文字"}}, "ja": {"stringUnit": {"state": "translated", "value": "テスト用テキストを送信"}}, "ko": {"stringUnit": {"state": "translated", "value": "테스트 텍스트 보내기"}}, "de": {"stringUnit": {"state": "translated", "value": "Testtext senden"}}, "fr": {"stringUnit": {"state": "translated", "value": "Envoyer un texte de test"}}, "es": {"stringUnit": {"state": "translated", "value": "Enviar texto de prueba"}}}},
    "等待设备接收": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Waiting for the device"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "等待设备接收"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "等待裝置接收"}}, "ja": {"stringUnit": {"state": "translated", "value": "デバイスの受信待ち"}}, "ko": {"stringUnit": {"state": "translated", "value": "기기 수신 대기 중"}}, "de": {"stringUnit": {"state": "translated", "value": "Warten auf das Gerät"}}, "fr": {"stringUnit": {"state": "translated", "value": "En attente de l’appareil"}}, "es": {"stringUnit": {"state": "translated", "value": "Esperando al dispositivo"}}}},
    "对方设备已接收": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Received by the device"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "对方设备已接收"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "對方裝置已接收"}}, "ja": {"stringUnit": {"state": "translated", "value": "相手のデバイスが受信済み"}}, "ko": {"stringUnit": {"state": "translated", "value": "상대 기기에서 수신함"}}, "de": {"stringUnit": {"state": "translated", "value": "Vom Gerät empfangen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Reçu par l’appareil"}}, "es": {"stringUnit": {"state": "translated", "value": "Recibido por el dispositivo"}}}},
    "已交给中继，等待设备接收": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Handed to relay. Delivery unconfirmed."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "已交给中继，送达未确认"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已交給中繼，尚未確認送達"}}, "ja": {"stringUnit": {"state": "translated", "value": "中継に送信済み。到達は未確認です。"}}, "ko": {"stringUnit": {"state": "translated", "value": "릴레이에 전달되었습니다. 수신 여부는 확인되지 않았습니다."}}, "de": {"stringUnit": {"state": "translated", "value": "An Relay übergeben. Zustellung unbestätigt."}}, "fr": {"stringUnit": {"state": "translated", "value": "Transmis au relais. Livraison non confirmée."}}, "es": {"stringUnit": {"state": "translated", "value": "Entregado al retransmisor. Entrega sin confirmar."}}}},
    "自动发送新复制的内容": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automatically send newly copied content"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动发送新复制的内容"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動傳送新拷貝的內容"}}, "ja": {"stringUnit": {"state": "translated", "value": "コピーした内容を自動送信"}}, "ko": {"stringUnit": {"state": "translated", "value": "새로 복사한 콘텐츠 자동 전송"}}, "de": {"stringUnit": {"state": "translated", "value": "Neu kopierte Inhalte automatisch senden"}}, "fr": {"stringUnit": {"state": "translated", "value": "Envoyer automatiquement le contenu copié"}}, "es": {"stringUnit": {"state": "translated", "value": "Enviar automáticamente el contenido recién copiado"}}}},
    "发送给所有已配对设备。关闭后，仍可在历史中选择设备手动发送。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send to every paired device. When disabled, you can still send from history to a device you choose."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送给所有已配对设备。关闭后，仍可在历史中选择设备手动发送。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳送到所有已配對裝置。關閉後，仍可從記錄選擇裝置手動傳送。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ペアリング済みのすべてのデバイスに送信します。オフにしても履歴から送信先を選べます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "페어링된 모든 기기로 보냅니다. 꺼도 기록에서 기기를 선택해 보낼 수 있습니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Sendet an alle gekoppelten Geräte. Ist die Option aus, kannst du im Verlauf ein Zielgerät auswählen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Envoie à tous les appareils jumelés. Si l’option est désactivée, choisissez un appareil dans l’historique pour envoyer un élément."}}, "es": {"stringUnit": {"state": "translated", "value": "Envía a todos los dispositivos enlazados. Si lo desactivas, puedes elegir un dispositivo en el historial y enviar manualmente."}}}},
    "重试待发内容并接收各已配对设备发来的内容": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Retry pending sends and receive clips from paired devices."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "重试待发内容并接收各已配对设备发来的内容"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重試待傳送的內容，並接收已配對裝置送來的項目。"}}, "ja": {"stringUnit": {"state": "translated", "value": "保留中の送信を再試行し、ペアリング済みのデバイスから項目を受信します。"}}, "ko": {"stringUnit": {"state": "translated", "value": "대기 중인 전송을 다시 시도하고 페어링된 기기의 항목을 받습니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Ausstehende Sendungen erneut versuchen und Clips von gekoppelten Geräten empfangen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Relancer les envois en attente et recevoir les éléments des appareils jumelés."}}, "es": {"stringUnit": {"state": "translated", "value": "Reintenta los envíos pendientes y recibe elementos de los dispositivos enlazados."}}}},
    "在历史列表中打码": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mask previews in history"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在历史列表中打码"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在記錄清單中遮蔽預覽"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴一覧のプレビューを隠す"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록 목록 미리보기 가리기"}}, "de": {"stringUnit": {"state": "translated", "value": "Vorschau im Verlauf maskieren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Masquer les aperçus dans l’historique"}}, "es": {"stringUnit": {"state": "translated", "value": "Ocultar vistas previas en el historial"}}}},
    "遮蔽可识别的密码、验证码与访问令牌预览。打码仅影响本机显示。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mask recognized passwords, verification codes and access tokens in previews on this Mac."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "遮蔽可识别的密码、验证码与访问令牌预览。打码仅影响本机显示。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "遮蔽可辨識的密碼、驗證碼與存取權杖預覽。只影響本機顯示。"}}, "ja": {"stringUnit": {"state": "translated", "value": "検出したパスワード、確認コード、アクセストークンをこの Mac のプレビューで隠します。"}}, "ko": {"stringUnit": {"state": "translated", "value": "인식된 비밀번호, 인증 코드 및 액세스 토큰은 이 Mac의 미리보기에서 가려집니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Erkannte Passwörter, Bestätigungscodes und Zugriffstoken werden in der Vorschau auf diesem Mac maskiert."}}, "fr": {"stringUnit": {"state": "translated", "value": "Masque les mots de passe, codes de validation et jetons d’accès détectés dans les aperçus sur ce Mac."}}, "es": {"stringUnit": {"state": "translated", "value": "Oculta las contraseñas, los códigos de verificación y los tokens de acceso detectados en las vistas previas de este Mac."}}}},
    "验证码列表和详情打码": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mask verification codes in history and details"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "验证码列表和详情打码"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在記錄清單和詳細資訊中遮蔽驗證碼"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴一覧と詳細の確認コードを隠す"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록과 세부 정보에서 인증 코드 가리기"}}, "de": {"stringUnit": {"state": "translated", "value": "Bestätigungscodes im Verlauf und in Details maskieren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Masquer les codes de validation dans l’historique et les détails"}}, "es": {"stringUnit": {"state": "translated", "value": "Ocultar códigos de verificación en el historial y los detalles"}}}},
    "在历史列表及详情中遮蔽可识别的验证码。复制时仍使用原文。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Mask recognized verification codes in history and details. Copying keeps the original text."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在历史列表及详情中遮蔽可识别的验证码。复制时仍使用原文。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在記錄清單和詳細資訊中遮蔽可辨識的驗證碼。拷貝時仍使用原文。"}}, "ja": {"stringUnit": {"state": "translated", "value": "検出した確認コードを履歴一覧と詳細で隠します。コピー時は元のテキストが使われます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "인식된 인증 코드를 기록과 세부 정보에서 가립니다. 복사할 때는 원문을 사용합니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Erkannte Bestätigungscodes im Verlauf und in Details maskieren. Beim Kopieren bleibt der Originaltext erhalten."}}, "fr": {"stringUnit": {"state": "translated", "value": "Masque les codes de validation détectés dans l’historique et les détails. Le texte original est conservé à la copie."}}, "es": {"stringUnit": {"state": "translated", "value": "Oculta los códigos de verificación detectados en el historial y los detalles. Al copiar se conserva el texto original."}}}},
    "验证设备连接": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Verify device connection"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "验证设备连接"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "驗證裝置連線"}}, "ja": {"stringUnit": {"state": "translated", "value": "デバイスの接続を確認"}}, "ko": {"stringUnit": {"state": "translated", "value": "기기 연결 확인"}}, "de": {"stringUnit": {"state": "translated", "value": "Geräteverbindung prüfen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifier la connexion"}}, "es": {"stringUnit": {"state": "translated", "value": "Verificar la conexión del dispositivo"}}}},
    "确认另一台设备也显示已配对，再发送一条固定的测试文字。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Check that the other device also shows it is paired, then send a sample message."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "确认另一台设备也显示已配对，再发送一条固定的测试文字。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "確認另一部裝置也顯示已配對，再傳送測試訊息。"}}, "ja": {"stringUnit": {"state": "translated", "value": "相手のデバイスでもペアリング済みと表示されることを確認し、テストメッセージを送信してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "다른 기기에도 페어링된 것으로 표시되는지 확인한 후 테스트 메시지를 보내세요."}}, "de": {"stringUnit": {"state": "translated", "value": "Prüfe, ob das andere Gerät ebenfalls als gekoppelt angezeigt wird, und sende dann eine Testnachricht."}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez que l’autre appareil indique aussi qu’il est jumelé, puis envoyez un message de test."}}, "es": {"stringUnit": {"state": "translated", "value": "Comprueba que el otro dispositivo también aparece como enlazado y envía un mensaje de prueba."}}}},
    "自动发送已开启。配对后，新复制的内容会发给所有已配对设备。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Auto-send is on. After pairing, newly copied content goes to all paired devices."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动发送已开启。配对后，新复制的内容会发给所有已配对设备。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動傳送已開啟。配對後，新拷貝的內容會傳送到所有已配對裝置。"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動送信がオンです。ペアリング後、コピーした内容はペアリング済みのすべてのデバイスに送信されます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "자동 전송이 켜져 있습니다. 페어링 후 새로 복사한 콘텐츠가 모든 페어링된 기기로 전송됩니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Automatisches Senden ist aktiv. Nach dem Koppeln gehen neu kopierte Inhalte an alle gekoppelten Geräte."}}, "fr": {"stringUnit": {"state": "translated", "value": "L’envoi automatique est activé. Après le jumelage, le nouveau contenu copié est envoyé à tous les appareils jumelés."}}, "es": {"stringUnit": {"state": "translated", "value": "El envío automático está activado. Tras el enlace, el contenido recién copiado se envía a todos los dispositivos enlazados."}}}},
    "自动发送已关闭。配对后，可在历史中选择设备手动发送。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Auto-send is off. After pairing, choose a device in history to send manually."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动发送已关闭。配对后，可在历史中选择设备手动发送。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動傳送已關閉。配對後，可從記錄選擇裝置手動傳送。"}}, "ja": {"stringUnit": {"state": "translated", "value": "自動送信がオフです。ペアリング後は、履歴で送信先を選んで手動で送信できます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "자동 전송이 꺼져 있습니다. 페어링 후 기록에서 기기를 선택해 직접 보낼 수 있습니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Automatisches Senden ist aus. Nach dem Koppeln kannst du im Verlauf ein Gerät zum Senden auswählen."}}, "fr": {"stringUnit": {"state": "translated", "value": "L’envoi automatique est désactivé. Après le jumelage, choisissez un appareil dans l’historique pour envoyer manuellement."}}, "es": {"stringUnit": {"state": "translated", "value": "El envío automático está desactivado. Tras el enlace, elige un dispositivo en el historial para enviar manualmente."}}}},
    "在另一台设备上核对以下指纹，再点「信任设备」。\n%@\n%@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Compare this fingerprint on the other device, then select “Trust Device”.\n%@\n%@"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在另一台设备上核对以下指纹，再点「信任设备」。\n%@\n%@"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在另一部裝置核對下方指紋，再點選「信任裝置」。\n%@\n%@"}}, "ja": {"stringUnit": {"state": "translated", "value": "別のデバイスで下のフィンガープリントを照合してから「デバイスを信頼」を選択してください。\n%@\n%@"}}, "ko": {"stringUnit": {"state": "translated", "value": "다른 기기에서 아래 지문을 확인한 후 ‘기기 신뢰’를 선택하세요.\n%@\n%@"}}, "de": {"stringUnit": {"state": "translated", "value": "Vergleiche diesen Fingerabdruck auf dem anderen Gerät und wähle „Gerät vertrauen“.\n%@\n%@"}}, "fr": {"stringUnit": {"state": "translated", "value": "Comparez cette empreinte sur l’autre appareil, puis choisissez « Faire confiance à l’appareil ».\n%@\n%@"}}, "es": {"stringUnit": {"state": "translated", "value": "Compara esta huella en el otro dispositivo y selecciona «Confiar en el dispositivo».\n%@\n%@"}}}},
    "请在另一台设备打开随贴，选择「输入配对码」并输入这 6 位数字。iPhone 也可扫描下方二维码。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open ClipRelay on the other device, choose “Enter Pairing Code” and enter these six digits. On iPhone, you can also scan the QR code below."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请在另一台设备打开随贴，选择「输入配对码」并输入这 6 位数字。iPhone 也可扫描下方二维码。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請在另一部裝置打開隨貼，選擇「輸入配對碼」並輸入這 6 位數字。也可使用 iPhone 掃描下方行動條碼。"}}, "ja": {"stringUnit": {"state": "translated", "value": "別のデバイスで ClipRelay を開き、「ペアリングコードを入力」を選んでこの 6 桁の数字を入力してください。iPhone では下の QR コードも使えます。"}}, "ko": {"stringUnit": {"state": "translated", "value": "다른 기기에서 ClipRelay를 열고 ‘페어링 코드 입력’을 선택한 후 이 6자리 숫자를 입력하세요. iPhone에서는 아래 QR 코드도 스캔할 수 있습니다."}}, "de": {"stringUnit": {"state": "translated", "value": "Öffne ClipRelay auf dem anderen Gerät, wähle „Kopplungscode eingeben“ und gib diese sechs Ziffern ein. Auf dem iPhone kannst du auch den QR-Code unten scannen."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez ClipRelay sur l’autre appareil, choisissez « Saisir le code de jumelage » et entrez ces six chiffres. Sur iPhone, vous pouvez aussi scanner le code QR ci-dessous."}}, "es": {"stringUnit": {"state": "translated", "value": "Abre ClipRelay en el otro dispositivo, selecciona «Introducir código de enlace» e introduce estos seis dígitos. En iPhone también puedes escanear el código QR de abajo."}}}},
    "请核对与另一台设备上显示的指纹一致，再点「信任设备」。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Make sure the fingerprint matches the one on the other device, then select “Trust Device”."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请核对与另一台设备上显示的指纹一致，再点「信任设备」。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "確認指紋與另一部裝置顯示的相同，再點選「信任裝置」。"}}, "ja": {"stringUnit": {"state": "translated", "value": "別のデバイスに表示されるフィンガープリントと一致することを確認し、「デバイスを信頼」を選択してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "다른 기기에 표시된 지문과 일치하는지 확인한 후 ‘기기 신뢰’를 선택하세요."}}, "de": {"stringUnit": {"state": "translated", "value": "Prüfe, ob der Fingerabdruck mit dem auf dem anderen Gerät übereinstimmt, und wähle „Gerät vertrauen“."}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez que l’empreinte correspond à celle affichée sur l’autre appareil, puis choisissez « Faire confiance à l’appareil »."}}, "es": {"stringUnit": {"state": "translated", "value": "Comprueba que la huella coincide con la del otro dispositivo y selecciona «Confiar en el dispositivo»."}}}},
    "在另一台设备打开随贴并选择「显示配对码」，然后在这里输入 6 位数字。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open ClipRelay on the other device and select “Show Pairing Code”, then enter the six digits here."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在另一台设备打开随贴并选择「显示配对码」，然后在这里输入 6 位数字。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在另一部裝置打開隨貼並選擇「顯示配對碼」，然後在此輸入 6 位數字。"}}, "ja": {"stringUnit": {"state": "translated", "value": "別のデバイスで ClipRelay を開いて「ペアリングコードを表示」を選び、表示された 6 桁の数字をここに入力してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "다른 기기에서 ClipRelay를 열고 ‘페어링 코드 보기’를 선택한 후 6자리 숫자를 여기에 입력하세요."}}, "de": {"stringUnit": {"state": "translated", "value": "Öffne ClipRelay auf dem anderen Gerät und wähle „Kopplungscode anzeigen“. Gib dann hier die sechs Ziffern ein."}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrez ClipRelay sur l’autre appareil et choisissez « Afficher le code de jumelage », puis saisissez les six chiffres ici."}}, "es": {"stringUnit": {"state": "translated", "value": "Abre ClipRelay en el otro dispositivo y selecciona «Mostrar código de enlace». A continuación, introduce aquí los seis dígitos."}}}},
    "请回到显示配对码的设备，核对指纹并点「信任设备」。": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "On the device showing the pairing code, compare the fingerprint and select “Trust Device”."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请回到显示配对码的设备，核对指纹并点「信任设备」。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "回到顯示配對碼的裝置，核對指紋並點選「信任裝置」。"}}, "ja": {"stringUnit": {"state": "translated", "value": "ペアリングコードを表示しているデバイスでフィンガープリントを照合し、「デバイスを信頼」を選択してください。"}}, "ko": {"stringUnit": {"state": "translated", "value": "페어링 코드가 표시된 기기에서 지문을 확인하고 ‘기기 신뢰’를 선택하세요."}}, "de": {"stringUnit": {"state": "translated", "value": "Vergleiche den Fingerabdruck auf dem Gerät mit dem Kopplungscode und wähle „Gerät vertrauen“."}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez l’empreinte sur l’appareil qui affiche le code de jumelage et choisissez « Faire confiance à l’appareil »."}}, "es": {"stringUnit": {"state": "translated", "value": "En el dispositivo que muestra el código de enlace, verifica la huella y selecciona «Confiar en el dispositivo»."}}}},
    "Restore default shortcut": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复默认"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復預設"}}}},
    "Mac history hub": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Mac 历史中枢"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "Mac 記錄中樞"}}}},
    "Mac history hub is unavailable": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法连接 Mac 历史中枢"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法連接 Mac 記錄中樞"}}}},
    "Refresh Mac history": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "刷新 Mac 历史"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重新整理 Mac 記錄"}}}},
    "Paired devices fetch history automatically when ClipRelay opens.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已配对设备打开随贴后会自动读取这台 Mac 的历史。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已配對裝置開啟隨貼後會自動讀取這台 Mac 的記錄。"}}}},
    "局域网发现与历史读取": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "局域网发现与历史读取"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "區域網路探索與記錄讀取"}}}},
    "设备通过局域网读取历史，传输使用 HPKE 加密。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "设备通过局域网读取历史，传输使用 HPKE 加密。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "裝置透過區域網路讀取記錄，傳輸使用 HPKE 加密。"}}}},
    "这会删除这台 Mac 的全部剪贴板历史，操作不可撤销。": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "这会删除这台 Mac 的全部剪贴板历史，操作不可撤销。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "這會刪除這台 Mac 的所有剪貼簿記錄，無法還原。"}}}},
    "Link": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "链接"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "鏈接"}}}},
    "Code": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "代码"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "代碼"}}}},
    "Document": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "文档"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "文檔"}}}},
    "Archive": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "压缩包"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "压缩包"}}}},
    "This Mac": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "本机"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "本机"}}}},
    "Select an item to view its details": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选择一条记录查看详情"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選择一條記录查看详情"}}}},
    "Clear search": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "清空搜索"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清空搜索"}}}},
    "Batch manage": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "批量管理"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "批量管理"}}}},
    "Filter by type": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "类型筛选"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "类型篩選"}}}},
    "Filter by source": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "来源筛选"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "來源篩選"}}}},
    "Reset": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "重置"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "重置"}}}},
    "No matching items": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "没有匹配的记录"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "没有匹配的記录"}}}},
    "View details": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "查看详情"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "查看详情"}}}},
    "Burn after copy": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "复制即焚"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "複製即焚"}}}},
    "On this Mac · Not synced": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "仅本机 · 尚未同步"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "仅本机 · 尚未同步"}}}},
    "Type or paste content and press Return…": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "输入 / 粘贴内容，回车添加到剪切板历史…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入 / 粘贴内容，回车添加到剪切板历史…"}}}},
    "Add to clipboard history": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "添加到剪切板历史"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "添加到剪切板历史"}}}},
    "Add from system clipboard": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "从系统剪贴板添加"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "從系统剪贴板添加"}}}},
    "Source device": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "来源设备"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "來源設备"}}}},
    "Last copied": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "最近复制"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "最近拷貝"}}}},
    "Remove excluded app?": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "移除排除的应用？"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "移除排除的 App？"}}}},
    "Clipboard content from %@ can be recorded again.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "随贴将可以再次记录来自 %@ 的剪贴板内容。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "隨貼將可以再次記錄來自 %@ 的剪貼簿內容。"}}}},
    "Remove": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "移除"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "移除"}}}},
    "Manage local clipboard data": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "管理本机剪贴板数据"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "管理本機剪貼簿資料"}}}},
    "Clear cache?": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "清理缓存？"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除快取？"}}}},
    "Time": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "时间"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "時间"}}}},
    "Size": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "大小"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "大小"}}}},
    "Expiration": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "过期设置"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "過期設置"}}}},
    "Never": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "不过期"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "不過期"}}}},
    "5 minutes": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "5 分钟"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "5 分鐘"}}}},
    "24 hours": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "24 小时"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "24 小時"}}}},
    "Turn off burn after copy": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "取消复制即焚"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "取消複製即焚"}}}},
    "Remove from this Mac when copied from history": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "再次从历史复制时移除本机记录"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "再次從历史复制時移除本机記录"}}}},
    "Export file": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "导出文件"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "导出文件"}}}},
    "Masked": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已遮盖"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已遮盖"}}}},
    "Source application": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "来源应用"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "來源應用"}}}},
    "Clear all filters": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "清除全部筛选"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除全部篩選"}}}},
    "Select item": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选中记录"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選中記录"}}}},
    "Click to copy": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "点击复制"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "点击复制"}}}},
    "%lld items": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "%lld 条"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "%lld 條"}}}},
    "%lld selected": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "已选 %lld 条"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "已選 %lld 條"}}}},
    "Confirm deletion of %lld items": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "确认删除 %lld 条"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "确认刪除 %lld 條"}}}},

    "Menu shortcut is unavailable": {"extractionState": "manual", "localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "菜单栏快捷键不可用"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選單列快速鍵無法使用"}}}},

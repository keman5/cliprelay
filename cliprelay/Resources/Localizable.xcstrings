    "Send to all paired devices": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send to all paired devices"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送给全部配对设备"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳送給所有配對裝置"}}, "ja": {"stringUnit": {"state": "translated", "value": "すべてのペアリング済み端末に送信"}}, "ko": {"stringUnit": {"state": "translated", "value": "페어링된 모든 기기로 보내기"}}, "de": {"stringUnit": {"state": "translated", "value": "An alle gekoppelten Geräte senden"}}, "fr": {"stringUnit": {"state": "translated", "value": "Envoyer à tous les appareils jumelés"}}, "es": {"stringUnit": {"state": "translated", "value": "Enviar a todos los dispositivos enlazados"}}}},
    "This iPhone": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This iPhone"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "本机"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "本機"}}, "ja": {"stringUnit": {"state": "translated", "value": "この端末"}}, "ko": {"stringUnit": {"state": "translated", "value": "이 기기"}}, "de": {"stringUnit": {"state": "translated", "value": "Dieses Gerät"}}, "fr": {"stringUnit": {"state": "translated", "value": "Cet appareil"}}, "es": {"stringUnit": {"state": "translated", "value": "Este dispositivo"}}}},
    "Relay while app is open": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Relay while app is open"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "前台运行时允许局域网中继"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在前景執行時允許區域網路中繼"}}, "ja": {"stringUnit": {"state": "translated", "value": "アプリの使用中に LAN 中継を許可"}}, "ko": {"stringUnit": {"state": "translated", "value": "앱 사용 중 LAN 릴레이 허용"}}, "de": {"stringUnit": {"state": "translated", "value": "LAN-Relay bei geöffneter App erlauben"}}, "fr": {"stringUnit": {"state": "translated", "value": "Autoriser le relais local au premier plan"}}, "es": {"stringUnit": {"state": "translated", "value": "Permitir retransmisión local en primer plano"}}}},
    "Open clipboard history": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open clipboard history"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开剪贴板历史"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "打開剪貼簿記錄"}}, "ja": {"stringUnit": {"state": "translated", "value": "クリップボード履歴を開く"}}, "ko": {"stringUnit": {"state": "translated", "value": "클립보드 기록 열기"}}, "de": {"stringUnit": {"state": "translated", "value": "Zwischenablageverlauf öffnen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Ouvrir l’historique du presse-papiers"}}, "es": {"stringUnit": {"state": "translated", "value": "Abrir el historial del portapapeles"}}}},
    "Select": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Select"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选择"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択"}}, "ko": {"stringUnit": {"state": "translated", "value": "선택"}}, "de": {"stringUnit": {"state": "translated", "value": "Auswählen"}}, "fr": {"stringUnit": {"state": "translated", "value": "Sélectionner"}}, "es": {"stringUnit": {"state": "translated", "value": "Seleccionar"}}}},
    "Choose a regular file instead of a folder or symbolic link": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Choose a regular file instead of a folder or symbolic link"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请选择普通文件，暂不支持文件夹或符号链接"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "請選擇一般檔案，暫不支援資料夾或符號連結"}}, "ja": {"stringUnit": {"state": "translated", "value": "フォルダやシンボリックリンクではなく通常のファイルを選んでください"}}, "ko": {"stringUnit": {"state": "translated", "value": "폴더나 심볼릭 링크 대신 일반 파일을 선택하세요"}}, "de": {"stringUnit": {"state": "translated", "value": "Bitte eine reguläre Datei auswählen. Ordner und symbolische Links werden nicht unterstützt."}}, "fr": {"stringUnit": {"state": "translated", "value": "Choisissez un fichier ordinaire. Les dossiers et liens symboliques ne sont pas pris en charge."}}, "es": {"stringUnit": {"state": "translated", "value": "Elige un archivo normal. Las carpetas y los enlaces simbólicos no son compatibles."}}}},
    "Searching…": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Searching…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在搜索…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在搜尋…"}}, "ja": {"stringUnit": {"state": "translated", "value": "検索中…"}}, "ko": {"stringUnit": {"state": "translated", "value": "검색 중…"}}, "de": {"stringUnit": {"state": "translated", "value": "Suche läuft…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Recherche…"}}, "es": {"stringUnit": {"state": "translated", "value": "Buscando…"}}}},
    "Verify to delete clipboard history": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Verify to delete clipboard history"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "验证身份以删除剪贴板历史"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "驗證身分以刪除剪貼簿記錄"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴を削除するために認証してください"}}, "ko": {"stringUnit": {"state": "translated", "value": "클립보드 기록을 삭제하려면 인증하세요"}}, "de": {"stringUnit": {"state": "translated", "value": "Zum Löschen des Verlaufs authentifizieren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Authentifiez-vous pour supprimer l’historique"}}, "es": {"stringUnit": {"state": "translated", "value": "Verifica tu identidad para eliminar el historial"}}}},
    "Release cached history rows from memory": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Release cached history rows from memory"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "释放历史列表占用的内存"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "釋放歷史列表佔用的記憶體"}}, "ja": {"stringUnit": {"state": "translated", "value": "履歴一覧のキャッシュ用メモリを解放"}}, "ko": {"stringUnit": {"state": "translated", "value": "기록 목록이 사용하는 메모리 해제"}}, "de": {"stringUnit": {"state": "translated", "value": "Arbeitsspeicher der Verlaufsliste freigeben"}}, "fr": {"stringUnit": {"state": "translated", "value": "Libérer la mémoire utilisée par la liste"}}, "es": {"stringUnit": {"state": "translated", "value": "Liberar la memoria usada por la lista del historial"}}}},
    "Clear list cache": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Clear list cache"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "清除列表缓存"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "清除列表快取"}}, "ja": {"stringUnit": {"state": "translated", "value": "一覧のキャッシュを消去"}}, "ko": {"stringUnit": {"state": "translated", "value": "목록 캐시 지우기"}}, "de": {"stringUnit": {"state": "translated", "value": "Listen-Cache leeren"}}, "fr": {"stringUnit": {"state": "translated", "value": "Vider le cache de la liste"}}, "es": {"stringUnit": {"state": "translated", "value": "Vaciar la caché de la lista"}}}},

    "%lld records to check for duplicates. %lld private or unavailable records skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld records to check for duplicates. %lld private or unavailable records skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将对 %lld 条记录去重，已跳过 %lld 条私密或不可用的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將對 %lld 筆記錄去除重複，已略過 %lld 筆私密或無法使用的記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の重複を確認します。非公開または利用できない%lld件をスキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 %lld개의 중복을 확인합니다. 비공개 또는 사용할 수 없는 기록 %lld개를 건너뛰었습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Einträge auf Duplikate prüfen. %lld private oder nicht verfügbare Einträge übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification des doublons pour %lld entrées. %lld entrées privées ou indisponibles ignorées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprobarán %lld registros para detectar duplicados. Se omitieron %lld registros privados o no disponibles."
          }
        }
      }
    },
    "%@\n%@\nPair both devices to enable delivery.": {
      "extractionState": "manual",

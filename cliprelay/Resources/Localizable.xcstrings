    "Keyboard imports can contain sensitive text. Sending uses paired devices and the cloud relay if enabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard imports can contain sensitive text. Sending uses paired devices and the cloud relay if enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘导入内容可能包含敏感文本。发送目标为已配对设备，启用云端中继时也可经中继传送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤匯入的內容可能包含敏感文字。內容會傳送至已配對裝置，啟用雲端中繼時也可能經由中繼傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込まれたテキストに機密情報が含まれる場合があります。ペアリング済みデバイスに送信し、有効な場合はクラウドリレーを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서 가져온 텍스트는 민감한 내용을 포함할 수 있습니다. 페어링된 기기로 전송하며 클라우드 릴레이가 켜져 있으면 이를 사용합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die Tastatur importierter Text kann vertrauliche Inhalte enthalten. Die Übertragung erfolgt an gekoppelte Geräte und bei aktiviertem Cloud-Relay auch darüber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte importé peut contenir des données sensibles. Il est envoyé aux appareils jumelés et passe par le relais cloud si celui-ci est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto importado puede contener datos sensibles. Se envía a dispositivos emparejados y usa el relé en la nube si está activado."
          }
        }
      }
    },
